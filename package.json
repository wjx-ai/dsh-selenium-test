{
  "name": "@wjx-ai/dsh-selenium-test",
  "version": "0.1.4",
  "description": "DSH（DeepSeek Harness）Selenium 浏览器自动化测试工具插件：注册 selenium_test 工具，通过真实浏览器对网页执行点击/输入/截图/等待/断言/跳转/执行 JS 等操作并返回每步结果与截图路径。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib/index.js",
    "lib/selenium_test.py",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "selenium",
    "browser",
    "automation",
    "webdriver",
    "test",
    "cordis",
    "plugin",
    "tool"
  ],
  "author": "wjx-ai",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wjx-ai/dsh-selenium-test.git"
  },
  "bugs": {
    "url": "https://github.com/wjx-ai/dsh-selenium-test/issues"
  },
  "homepage": "https://github.com/wjx-ai/dsh-selenium-test#readme",
  "publishConfig": {
    "access": "public"
  }
}
